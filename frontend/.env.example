# Frontend build-time config (Vite inlines these at build time).
# Copy to frontend/.env.local for local overrides; never commit real values.

# Base URL for the API, including the /api suffix.
#
# Leave UNSET for local dev — api.js falls back to "/api", which Vite's dev
# proxy forwards to http://localhost:8000 (see vite.config.js).
#
# For Static Web Apps, set this in the build environment (Azure portal ->
# your SWA -> Configuration -> Application settings, or as an env var in the
# GitHub Actions build step) to the App Service origin:
#   VITE_API_URL=https://<your-app>.azurewebsites.net/api
VITE_API_URL=
