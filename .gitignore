__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Virtualenv. This project's is .ven (see .ven/pyvenv.cfg, Python 3.10.11);
# the conventional names are listed too so a rebuilt env can't sneak in.
.ven/
.venv/
venv/
env/

# Raw and derived data are regenerated by the pipeline; keep the repo light.
data/bronze/
data/gold/
data/raw/*.csv

# ...except the two silver Parquet files, which are a runtime dependency, not
# just a build artifact: backend/kb_retrieval.py loads them to ground
# classification and response generation on the 386 canonical KB entries. If
# they're missing the index is None and retrieve_candidates() returns [] with
# no error and no log, so KB grounding degrades silently. ~950K total.
# NOTE: this ignores the directory *contents* (data/silver/*), not the
# directory (data/silver/) — git does not descend into an ignored directory,
# so a negation for a file inside one never takes effect.
data/silver/*
!data/silver/tickets.parquet
!data/silver/resolutions.parquet

.DS_Store

# Ticket resolution agent backend
.env
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm
# Customer attachments (db.uploads_dir(), next to the DB)
backend/uploads/

# React frontend
frontend/node_modules/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/dist/

.agents/
.claude/
