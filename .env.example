# Copy to .env for local dev. On Azure App Service set these as
# Application Settings instead (Configuration -> Application settings).
# Never commit real values.

# --- AI provider (backend/ai_service/provider.py, backends.py) -------------
# quickml_appsail | openai_compatible | azure | mock
# Unset -> azure if AZURE_OPENAI_ENDPOINT is set, else mock (placeholder
# replies; logged as an error in production). Real GLM calls only work on
# AppSail; use mock locally.
AI_PROVIDER=mock
# Upper bound we request/expect; QuickML's own cap is fixed on the endpoint.
AI_MAX_TOKENS=2048
# Seconds per model call (GLM-4.7-Flash is a reasoning model: allow time).
AI_TIMEOUT_SECONDS=90

# Catalyst QuickML LLM Serving via AppSail (docs/quickml-appsail-call.md).
# The call is authenticated with the credential AppSail injects into each
# request; no OAuth client or token is stored. Set these in the AppSail
# console (Configuration > Environment Variables), per environment.
QUICKML_ENDPOINT_KEY=
# The endpoint's name, from its URL: .../genai/endpoints/<name>/generate
QUICKML_ENDPOINT_NAME=
# Your Catalyst org id (sent as the CATALYST-ORG header; required).
# Catalyst rejects env var names containing CATALYST ("reserved keywords"),
# hence QUICKML_ORG_ID; CATALYST_ORG_ID is still read as a local fallback.
QUICKML_ORG_ID=
# Fallback for the Environment header when AppSail doesn't inject
# X-ZC-Environment: Development or Production.
QUICKML_ENVIRONMENT=Development
# Optional: API base if AppSail's X_ZOHO_CATALYST_CONSOLE_URL is absent.
QUICKML_API_BASE=https://api.catalyst.zoho.in

# openai_compatible (optional): any OpenAI-style chat completions API.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional embeddings model for incident grouping/memory; unset -> lexical.
AI_EMBEDDING_MODEL=

# azure (until Phase 4 stage C6).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# --- Auth (backend/auth.py) ------------------------------------------------
# Use a long random string in production (e.g. `openssl rand -hex 32`).
# Changing it invalidates every issued JWT.
JWT_SECRET=change-me-to-a-random-string

# --- Environment + single admin (backend/auth.py) --------------------------
# APP_ENV=production makes ADMIN_EMAIL/ADMIN_PASSWORD mandatory (startup
# fails without them) and skips the dev-only demo manager/technician seed.
# Anything else (or unset) is treated as development.
APP_ENV=development
# The one admin account, created on first startup if no admin exists yet.
# Never overwrites an existing admin, so changing these later does not
# reset a password. Unset outside production -> a dev-only fallback admin
# is created with a loud warning in the log.
ADMIN_EMAIL=admin@your-company.example
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional Azure embeddings deployment (only with AI_PROVIDER=azure).
# Unset -> incident grouping uses lexical (TF-IDF) similarity.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Incident correlation (backend/incidents.py) ----------------------------
# Starting values: the admin can override all four in Admin > Settings
# (stored in the database, which then wins over these).
# Tickets created within this many hours are considered together.
INCIDENT_WINDOW_HOURS=12
# Pre-filter before asking the AI (limits model calls): a candidate group
# needs at least this many tickets, from at least two customers. Use 2-3
# for a demo.
INCIDENT_MIN_TICKETS=3
# Cosine bar for splitting a component area's tickets into candidate groups.
# Lexical TF-IDF by default (same outage ~0.2-0.35, unrelated <0.12); use
# ~0.80 if an embeddings model is configured.
INCIDENT_SIMILARITY=0.15
# Below this AI confidence an incident gets no department ("Needs routing")
# and waits for the admin or a manager to route it.
INCIDENT_ROUTING_CONFIDENCE=0.6
# How many days a resolved incident (and its approved customer summary) is
# remembered to answer customers asking "was there an outage on ...?".
INCIDENT_MEMORY_DAYS=90

# --- Outbound email (backend/email_utils.py) -------------------------------
# Real email is OFF by default: the email-style ticket thread is an in-app
# format. Only with EMAIL_ENABLED=true AND SMTP_HOST/SMTP_FROM set are AI and
# technician replies on tickets also emailed to the customer.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=support@your-company.example
# STARTTLS on by default; set to false only for a local test relay.
SMTP_USE_TLS=true

# --- Database (backend/db.py) ----------------------------------------------
# Unset locally -> backend/ticketapp.db next to the module.
# On App Service only /home persists across restarts and deploys, so point
# it there or the SQLite file is lost on every restart:
#   DB_PATH=/home/data/ticketapp.db
# The parent directory is created on startup if missing. Customer attachments
# are stored next to it, in <DB_PATH parent>/uploads (so /home/data/uploads on
# App Service, which persists).
DB_PATH=
# SQLite journal mode: WAL (default, local disk) or DELETE. Use DELETE on
# App Service: /home is a network share and WAL isn't reliable there.
SQLITE_JOURNAL_MODE=

# --- CORS (backend/main.py) ------------------------------------------------
# Comma-separated explicit origins. Unset -> http://localhost:5173 plus the
# Vite preview port. In production set the Static Web Apps origin, e.g.
#   ALLOWED_ORIGINS=https://<your-swa>.azurestaticapps.net
# Must be explicit origins: "*" is invalid alongside allow_credentials=True.
ALLOWED_ORIGINS=
