# Copy to .env for local dev. On Azure App Service set these as
# Application Settings instead (Configuration -> Application settings).
# Never commit real values.

# --- Azure OpenAI (backend/ai_service/provider.py) ------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>

# --- Auth (backend/auth.py) ------------------------------------------------
# Use a long random string in production (e.g. `openssl rand -hex 32`).
# Changing it invalidates every issued JWT.
JWT_SECRET=change-me-to-a-random-string

# --- Environment + single admin (backend/auth.py) --------------------------
# APP_ENV=production makes ADMIN_EMAIL/ADMIN_PASSWORD mandatory (startup
# fails without them) and skips the dev-only demo manager/technician seed.
# Anything else (or unset) is treated as development.
APP_ENV=development
# The one admin account, created on first startup if no admin exists yet.
# Never overwrites an existing admin, so changing these later does not
# reset a password. Unset outside production -> a dev-only fallback admin
# is created with a loud warning in the log.
ADMIN_EMAIL=admin@your-company.example
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Outbound email (backend/email_utils.py) -------------------------------
# Optional. When SMTP_HOST and SMTP_FROM are set, AI replies on tickets raised
# via "Raise a ticket" are also emailed to the customer. Unset -> replies only
# appear in the ticket thread (no error).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=support@your-company.example
# STARTTLS on by default; set to false only for a local test relay.
SMTP_USE_TLS=true

# --- Database (backend/db.py) ----------------------------------------------
# Unset locally -> backend/ticketapp.db next to the module.
# On App Service only /home persists across restarts and deploys, so point
# it there or the SQLite file is lost on every restart:
#   DB_PATH=/home/data/ticketapp.db
# The parent directory is created on startup if missing. Customer attachments
# are stored next to it, in <DB_PATH parent>/uploads (so /home/data/uploads on
# App Service, which persists).
DB_PATH=

# --- CORS (backend/main.py) ------------------------------------------------
# Comma-separated explicit origins. Unset -> http://localhost:5173 plus the
# Vite preview port. In production set the Static Web Apps origin, e.g.
#   ALLOWED_ORIGINS=https://<your-swa>.azurestaticapps.net
# Must be explicit origins: "*" is invalid alongside allow_credentials=True.
ALLOWED_ORIGINS=
